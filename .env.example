# Demo never requires a database or provider credentials.
WORLD_SIGNAL_MODE=demo
# npm run db:local creates an isolated local PostgreSQL cluster and writes .env.local.
DATABASE_URL=postgresql://world_signal:change-me@127.0.0.1:55432/world_signal
# Public NASA downloads need no key. Explicit api mode requires NASA_FIRMS_API_KEY.
FIRMS_TRANSPORT=public
NASA_FIRMS_API_KEY=
# Public mode uses NOAA-20 only; mixing sensors would change the count baseline.
USGS_INTERVAL_MINUTES=5
FIRMS_INTERVAL_MINUTES=60
USGS_STALE_MINUTES=20
FIRMS_STALE_MINUTES=240
FIRMS_OBSERVATION_MAX_AGE_HOURS=12
FIRMS_SETTLEMENT_HOURS=3
# Provisional fire baselines are labeled with their actual sample count; 30 days is the target.
FIRE_MIN_BASELINE_WINDOWS=5
FIRE_MIN_BASELINE_DETECTIONS=20
FIRE_MIN_CURRENT_DETECTIONS=20
FIRE_RATIO_THRESHOLDS=2,3,4
QUAKE_MIN_MAGNITUDE=5
QUAKE_SHALLOW_MIN_MAGNITUDE=4.5
QUAKE_SHALLOW_MAX_DEPTH_KM=70
QUAKE_MIN_SIGNIFICANCE=600
QUAKE_CLUSTER_MIN_MAGNITUDE=2.5
QUAKE_CLUSTER_MIN_COUNT=5
QUAKE_CLUSTER_MIN_BASELINE_WINDOWS=14
QUAKE_CLUSTER_Z_THRESHOLDS=2,3,4
# Optional isolated integration-test DB. Its database name MUST end with _test.
# TEST_DATABASE_URL=postgresql://world_signal:change-me@127.0.0.1:55432/world_signal_test
# Ordered severity boundaries; the lowest band remains gated by event-selection rules.
QUAKE_SEVERITY_MAGNITUDES=4.5,5.5,6
QUAKE_SEVERITY_SIGNIFICANCE=600,750,1000

# Universal world-event refresh. Open-Meteo is opt-in locally.
WORLD_EVENT_REFRESH_ENABLED=true
OPEN_METEO_ENABLED=false
# Free endpoint is evaluation/non-commercial only; use customer-api + API key for commercial operation.
OPEN_METEO_ENDPOINT=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=

# IODA public outage-event API. Set false to disable Internet event collection.
IODA_ENABLED=true
IODA_ENDPOINT=https://api.ioda.inetintel.cc.gatech.edu/v2/outages/events

# Optional compact profile for small hosted databases (0 preserves full raw history).
FIRMS_RAW_RETENTION_HOURS=0
FIRMS_RAW_SAMPLES_PER_CELL_HOUR=0
DATABASE_POOL_MAX=5
# Custom hosted PostgreSQL CA, with escaped \n or literal newlines; verifies TLS.
DATABASE_SSL_CA=
ANALYSIS_STALE_MINUTES=15
COLLECTION_CADENCE_MINUTES=5
